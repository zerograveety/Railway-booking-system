# Copy this file to .env and fill in real values (never commit .env)
# Get an IRCTC RapidAPI key from https://rapidapi.com/irctc/api/irctc
RAPIDAPI_KEY=your_rapidapi_key_here

# Flask secret key - set a random value in production
SECRET_KEY=your_secret_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost/railway
